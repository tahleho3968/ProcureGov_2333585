<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="false">

    <display-name>ProcureGov - Tender Management System</display-name>
    
    <!-- Welcome file list -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>
    
    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.procuregov.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.procuregov.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.procuregov.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Tender Servlet -->
    <servlet>
        <servlet-name>TenderServlet</servlet-name>
        <servlet-class>com.procuregov.controller.TenderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TenderServlet</servlet-name>
        <url-pattern>/officer/tender</url-pattern>
    </servlet-mapping>

    <!-- Download Servlet -->
    <servlet>
        <servlet-name>DownloadServlet</servlet-name>
        <servlet-class>com.procuregov.controller.DownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadServlet</servlet-name>
        <url-pattern>/download</url-pattern>
    </servlet-mapping>

    <!-- Bid Submission Servlet -->
    <servlet>
        <servlet-name>BidSubmissionServlet</servlet-name>
        <servlet-class>com.procuregov.controller.BidSubmissionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BidSubmissionServlet</servlet-name>
        <url-pattern>/supplier/bid</url-pattern>
    </servlet-mapping>

    <!-- Supplier Dashboard Servlet -->
    <servlet>
        <servlet-name>SupplierDashboardServlet</servlet-name>
        <servlet-class>com.procuregov.controller.SupplierDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SupplierDashboardServlet</servlet-name>
        <url-pattern>/supplier/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Evaluator Dashboard Servlet -->
    <servlet>
        <servlet-name>EvaluatorDashboardServlet</servlet-name>
        <servlet-class>com.procuregov.controller.EvaluatorDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EvaluatorDashboardServlet</servlet-name>
        <url-pattern>/evaluator/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Evaluation Servlet -->
    <servlet>
        <servlet-name>EvaluationServlet</servlet-name>
        <servlet-class>com.procuregov.controller.EvaluationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EvaluationServlet</servlet-name>
        <url-pattern>/evaluator/evaluate</url-pattern>
    </servlet-mapping>

    <!-- View Results Servlet -->
    <servlet>
        <servlet-name>ViewResultsServlet</servlet-name>
        <servlet-class>com.procuregov.controller.ViewResultsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewResultsServlet</servlet-name>
        <url-pattern>/evaluator/viewResults</url-pattern>
    </servlet-mapping>

    <!-- Test Email Servlet -->
    <servlet>
        <servlet-name>TestEmailServlet</servlet-name>
        <servlet-class>com.procuregov.controller.TestEmailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestEmailServlet</servlet-name>
        <url-pattern>/testemail</url-pattern>
    </servlet-mapping>

    <!-- Award Servlet -->
    <servlet>
        <servlet-name>AwardServlet</servlet-name>
        <servlet-class>com.procuregov.controller.AwardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AwardServlet</servlet-name>
        <url-pattern>/officer/award</url-pattern>
    </servlet-mapping>

</web-app>
